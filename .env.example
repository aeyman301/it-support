# Server
PORT=3000

# Shared token required for status-changing actions (assign/resolve/close/comment).
# Anyone with this token can act on tickets - keep it secret, share only with your IT team.
ADMIN_TOKEN=change-me

# --- Firebase (database) ---
# Create a Firebase project at https://console.firebase.google.com, enable Firestore
# (Native mode) and Storage, then generate a service account key:
# Project settings -> Service accounts -> Generate new private key. That downloads a
# JSON file - base64-encode it and paste the result below, e.g.:
#   base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Alternative to the above: paste the raw JSON key on one line instead.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Storage bucket for ticket attachments, e.g. your-project-id.appspot.com
FIREBASE_STORAGE_BUCKET=

# Telegram bot notifications
# Create a bot via @BotFather to get a token, then message your bot and call
# https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email documentation (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="IT Support <it-support@example.com>"
# Where every ticket gets documented (can be a shared mailbox/distribution list)
EMAIL_DOCUMENTATION_TO=it@pnatech.com.my
