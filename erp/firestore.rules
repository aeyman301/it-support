rules_version = '2';

// Starting point: any signed-in user of your Firebase project can read/write
// planning data. Tighten this (e.g. check a custom claim or a `users`
// collection role) before giving this to a wider audience than your own
// planning team.
service cloud.firestore {
  match /databases/{database}/documents {
    match /materials/{materialId} {
      allow read, write: if request.auth != null;
    }
    match /purchaseOrders/{orderId} {
      allow read, write: if request.auth != null;
    }
    match /productionPlan/{entryId} {
      allow read, write: if request.auth != null;
    }
  }
}
